FROM registry.access.redhat.com/ubi9/python-311:1

LABEL maintainer="Edge Architecture Team" \
      io.k8s.description="Enterprise Edge Data Triage & Deduplication Engine" \
      io.k8s.display-name="Edge Triage Engine" \
      io.openshift.tags="edge,triage,mcap,usearch,openshift"

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    mkdir -p /opt/app-root/bin && \
    if python3 -c "import imageio_ffmpeg" 2>/dev/null; then \
        FFMPEG_BIN=$(python3 -c "import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())"); \
        chmod 755 "$FFMPEG_BIN" && ln -sf "$FFMPEG_BIN" /opt/app-root/bin/ffmpeg; \
    fi

# Copy application source
COPY triage_engine/ ./triage_engine/
COPY simulator/ ./simulator/

USER 0

# Support OpenShift arbitrary UID restricted SCC (group 0 write access)
# Pre-seed /tmp/healthy so container passes initial healthcheck prior to process start
RUN mkdir -p /var/cache/usearch /tmp && \
    touch /tmp/healthy && \
    chgrp -R 0 /app /var/cache/usearch /tmp && \
    chmod -R g=u /app /var/cache/usearch /tmp && \
    chmod -R g+rwX /app /var/cache/usearch /tmp

USER 1001:0

VOLUME ["/var/cache/usearch", "/tmp"]

EXPOSE 8080

ENV PYTHONUNBUFFERED=1 \
    CONFIG_PATH=/etc/triage-config/triage_policy.yaml \
    RAW_INGEST_PATH=/mnt/raw_ingest \
    GDS_CURATED_PATH=/mnt/gds_curated \
    METRICS_PORT=8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import os, sys, time; sys.exit(0 if (time.time() - os.path.getmtime('/tmp/healthy')) < 30 else 1)"

CMD ["python3", "-m", "triage_engine.main"]
